generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CASHIER
  KITCHEN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  DRAFT
  TO_COOK
  PREPARING
  COMPLETED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CASHIER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  color    String    @default("#6366f1")
  products Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(uuid())
  name        String
  price       Float
  tax         Float       @default(0)
  description String?
  image       String?
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("products")
}

model Floor {
  id     String  @id @default(uuid())
  name   String
  tables Table[]

  @@map("floors")
}

model Table {
  id          String      @id @default(uuid())
  tableNumber Int
  seats       Int
  status      TableStatus @default(AVAILABLE)
  qrToken     String      @unique @default(uuid())
  floorId     String
  floor       Floor       @relation(fields: [floorId], references: [id])
  orders      Order[]

  @@map("tables")
}

model Customer {
  id     String  @id @default(uuid())
  name   String
  email  String?
  phone  String?
  orders Order[]

  @@map("customers")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  status      OrderStatus @default(DRAFT)
  subtotal    Float       @default(0)
  tax         Float       @default(0)
  discount    Float       @default(0)
  total       Float       @default(0)
  tableId     String?
  table       Table?      @relation(fields: [tableId], references: [id])
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  couponId    String?
  coupon      Coupon?     @relation(fields: [couponId], references: [id])
  items       OrderItem[]
  payment     Payment?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  completed Boolean @default(false)

  @@map("order_items")
}

model Payment {
  id                 String        @id @default(uuid())
  orderId            String        @unique
  order              Order         @relation(fields: [orderId], references: [id])
  method             PaymentMethod
  amount             Float
  status             PaymentStatus @default(PENDING)
  transactionReference String?
  createdAt          DateTime      @default(now())

  @@map("payments")
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Float
  active        Boolean      @default(true)
  orders        Order[]

  @@map("coupons")
}
